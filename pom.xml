<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.4</version>
        <relativePath/>
    </parent>

    <groupId>com.example.testinglearning</groupId>
    <artifactId>testing-learning</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>testing-learning</name>
    <description>Learning project for the classical testing pyramid with Spring Boot 4</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Spring Boot 4 renames spring-boot-starter-web to spring-boot-starter-webmvc. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Spring Boot 4 splits Kafka autoconfiguration (incl. @ServiceConnection support for
             org.testcontainers.kafka.KafkaContainer) out of spring-boot-autoconfigure into this
             dedicated starter, same pattern as the webmvc-test / data-jpa-test splits above. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka</artifactId>
        </dependency>

        <!-- Bean Validation (Hibernate Validator) for @Valid request bodies and constrained
             @RequestParams (see docs/testing-strategy.md #9). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Spring Boot 4 splits RestClient.Builder autoconfiguration (HTTP message converters,
             request-factory detection) out of the web starter into this one. Used by
             ShippingClient for the outbound call to the carrier (see docs/testing-strategy.md #7). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient</artifactId>
        </dependency>

        <!-- Retry + CircuitBreaker around the carrier call. The spring-boot4 module binds
             resilience4j.retry.* / resilience4j.circuitbreaker.* properties into RetryRegistry /
             CircuitBreakerRegistry beans. ResilientShippingClient applies them programmatically,
             so no AOP starter is needed for the annotations. -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-spring-boot4</artifactId>
            <version>2.4.0</version>
        </dependency>

        <!-- Bearer-token (JWT) resource server: validates tokens issued by Keycloak (see
             docs/testing-strategy.md #8). Boot 4 renamed this from
             spring-boot-starter-oauth2-resource-server, which is now deprecated. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Spring Security Test: jwt() / @WithMockUser, and the MockMvc security wiring used by
             the @WebMvcTest slices. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Property-based testing (see docs/testing-strategy.md #9): jqwik generates hundreds of
             inputs per property instead of a handful of hand-picked examples. It's a separate
             JUnit Platform engine, so Surefire discovers @Property methods next to @Test ones. -->
        <dependency>
            <groupId>net.jqwik</groupId>
            <artifactId>jqwik</artifactId>
            <version>1.10.1</version>
            <scope>test</scope>
        </dependency>

        <!-- A real Keycloak as a Testcontainer, for the one security test that runs the whole chain
             with real tokens. Not managed by Boot, hence the pinned version (built against
             Testcontainers 2.x). -->
        <dependency>
            <groupId>com.github.dasniko</groupId>
            <artifactId>testcontainers-keycloak</artifactId>
            <version>4.3.1</version>
            <scope>test</scope>
        </dependency>

        <!-- @RestClientTest lives in its own module in Spring Boot 4. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- A real HTTP server standing in for the carrier. The -standalone jar shades its own
             Jetty + Jackson 2, so it can't clash with Boot 4's Jackson 3. Boot doesn't manage
             WireMock's version, hence the explicit pin. -->
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <version>3.13.2</version>
            <scope>test</scope>
        </dependency>

        <!-- Spring Boot 4 splits @DataJpaTest / AutoConfigureTestDatabase / TestEntityManager
             out of spring-boot-starter-test into this dedicated starter. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Same split for the web layer: @WebMvcTest / MockMvc auto-configuration live here. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- @AutoConfigureRestTestClient — RestTestClient bound to MockMvc in slice tests, and to
             the live server in @SpringBootTest(RANDOM_PORT) tests later (§5). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-resttestclient</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-kafka</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- await().untilAsserted(...) for asserting the async side effect of a Kafka consumer
             (see docs/testing-strategy.md #6) - never Thread.sleep. -->
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
